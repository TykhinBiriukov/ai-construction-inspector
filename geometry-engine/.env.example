SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_STORAGE_BUCKET=inspection-captures
SUPABASE_SECRET_KEY=your-server-secret-key

# Optional: defaults to geometry-engine/data when omitted.
# GEOMETRY_DATA_DIR=C:/path/to/data
# Downloads: raw/{session_id}/; results: processed/{session_id}/

# Meta Model API: SAM 3.1. Required only for segmentation.
# Add your key to .env; never commit a real key.
MODEL_API_KEY=

# Durable worker and SAM request cache. Change the epoch to invalidate old inference.
SAM_CACHE_EPOCH=1
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=10

# Optional externally reachable API base URL for agent artifact links.
# GEOMETRY_PUBLIC_BASE_URL=https://geometry.example.com
# Optional independent signing key (at least 16 characters).
# By default links are signed using a purpose-derived server Storage secret.
# RESULT_URL_SIGNING_SECRET=

# Database connection. DATABASE_URL overrides the POSTGRES_* settings when set.
# Example: postgresql+psycopg://user:password@db-host:5432/geometry_engine
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=geometry_engine
POSTGRES_USER=geometry_engine
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
