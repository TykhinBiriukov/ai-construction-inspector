# Copy to .env or set process environment. No credentials are built into the app.
INSPECTOR_OPERATOR_TOKEN=replace-with-a-random-operator-token
INSPECTOR_DEVICE_TOKEN=replace-with-a-different-random-device-token
INSPECTOR_PROJECT_ID=demo-building
INSPECTOR_DEVICE_ID=iphone-1
INSPECTOR_POLICY_VERSION=demo-policy-v1
INSPECTOR_DATA_DIR=./data
INSPECTOR_MAX_BIM_BYTES=104857600

# Web agent: Meta Model API / Muse Spark 1.3. Keep the real key on the server.
INSPECTOR_META_BASE_URL=https://api.meta.ai/v1
INSPECTOR_META_MODEL=muse-spark-1.3
INSPECTOR_META_API_KEY=
INSPECTOR_META_TIMEOUT_S=30
INSPECTOR_AGENT_MAX_STEPS=6
INSPECTOR_REMOTE_AGENTS_JSON=[]

# Capture source verification. AWS credentials use the normal boto3 credential chain.
# Leave bucket empty until the capture storage is available.
INSPECTOR_CAPTURE_BUCKET=
INSPECTOR_CAPTURE_REGION=eu-central-1
INSPECTOR_MAX_MANIFEST_BYTES=8388608
INSPECTOR_MAX_CAPTURE_FILES=40000
INSPECTOR_MAX_CAPTURE_BYTES=53687091200
INSPECTOR_SOURCE_URL_LIFETIME_S=900

# Intentionally blank: the generator's address has not been chosen yet.
INSPECTOR_GEOMETRY_BASE_URL=
# Server credential for Inspector -> Geometry API.
INSPECTOR_GEOMETRY_API_TOKEN=
# Set for HTTP Basic authentication; blank uses Bearer authentication.
INSPECTOR_GEOMETRY_API_USERNAME=
# ID of the registered Geometry Inspector (kind discrepancy_inspector); its service config selects Geometry Verifier.
INSPECTOR_GEOMETRY_REVIEW_INSPECTOR_ID=
INSPECTOR_GEOMETRY_TIMEOUT_S=15
INSPECTOR_WORKER_INTERVAL_S=1

# Optional Supabase session folders. Set all three together to enable.
# The real secret belongs only in the ignored .env or server environment.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=

# Device delivery, geometry-only completion, and optional browser clients.
INSPECTOR_GEOMETRY_POLL_INTERVAL_S=2
INSPECTOR_MAX_CAPTURE_FILE_BYTES=52428800
INSPECTOR_CORS_ORIGINS=

# Single-ZIP captures; Supabase's own account/bucket limits also apply.
INSPECTOR_MAX_ARCHIVE_BYTES=52428800
INSPECTOR_MAX_UNPACKED_ARCHIVE_BYTES=2147483648
INSPECTOR_MAX_ARCHIVE_ENTRIES=40000

# Optional persistent cloud metadata; leave empty for local SQLite.
# Use a restricted server role and the Supabase Session pooler URI with TLS.
INSPECTOR_DATABASE_URL=
# local (default) or supabase. Supabase keeps reference BIM bytes in private Storage.
INSPECTOR_BIM_STORAGE=local

# Optional prepared demo input library; native Docker image supplies its bundled path.
# Used only when INSPECTOR_SAVED_DEMO_DIR enables examples. An explicit manifest there wins.
INSPECTOR_SAVED_DEMO_INPUTS_DIR=

# Optional Langfuse Cloud (server-only project credentials; never put real keys here).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
INSPECTOR_LANGFUSE_PROMPTS_ENABLED=false
INSPECTOR_LANGFUSE_PROMPT_LABEL=production

# Optional separate Geometry export/result Storage; set all three together.
# Original Inspector capture/BIM storage remains unchanged.
INSPECTOR_GEOMETRY_SUPABASE_URL=
INSPECTOR_GEOMETRY_SUPABASE_STORAGE_BUCKET=
INSPECTOR_GEOMETRY_SUPABASE_SECRET_KEY=
