# Store real values in hosting Secrets or an ignored local .env, never in chat.
MINION_SERVICE_TOKEN=
MINION_META_API_KEY=
# Optional dedicated relay; requires its own token. Do not reuse the service token.
MINION_META_PROXY_URL=
MINION_META_PROXY_TOKEN=
MINION_DATA_DIR=/data
# Required in cloud. Use restricted role, TLS, direct or SESSION pooler (5432).
MINION_DATABASE_URL=
