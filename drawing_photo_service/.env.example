# Store real values in hosting Secrets or an ignored local .env, never in chat.
MINION_SERVICE_TOKEN=
MINION_META_API_KEY=
MINION_DATA_DIR=/data
# Required in cloud. Use restricted role, TLS, direct or SESSION pooler (5432).
MINION_DATABASE_URL=

# Optional server-only Langfuse project settings (service reads process env).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_ENABLED=true
INSPECTOR_LANGFUSE_PROMPTS_ENABLED=false
